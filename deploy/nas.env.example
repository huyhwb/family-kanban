# 复制成项目根目录下的 .env 即可生效（与 docker-compose.yml 同级）
# 全部为可选项，不配就用下面的默认值

# NAS 上对外开放的端口
KANBAN_PORT=12333

# 数据目录（数据库 + 头像）。不设则用项目目录下的 ./data
# 飞牛 / fnOS 这类系统建议挂在数据卷上，例如：
DATA_DIR_HOST=/vol1/1000/Docker/family-kanban

# ---- 基础镜像 ----
# 默认走 DaoCloud 镜像站，因为 Docker Hub 直连在国内多数宽带下不通。
# 实测可用（2026-10-17）：docker.m.daocloud.io / docker.1ms.run
# 想用官方源（例如 NAS 上有代理）就改成 node:22-slim
BASE_IMAGE=docker.m.daocloud.io/library/node:22-slim
# BASE_IMAGE=node:22-slim
# BASE_IMAGE=docker.1ms.run/library/node:22-slim

# ---- npm 源 ----
# 官方源通常能连，慢的话换成 npmmirror
NPM_REGISTRY=https://registry.npmjs.org/
# NPM_REGISTRY=https://registry.npmmirror.com

# ---- better-sqlite3 预编译包镜像 ----
# 留空则从 GitHub 取；拉不动时构建会自动改为源码编译（慢但能过），也可以直接指向镜像
BETTER_SQLITE3_MIRROR=
# BETTER_SQLITE3_MIRROR=https://npmmirror.com/mirrors/better-sqlite3
